rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        request.auth.token.get('organizationId', '') == orgId ||
        request.auth.token.get('orgId', '') == orgId
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') in ['admin', 'super_admin', 'platform_authority', 'hq_admin', 'ceo', 'ops_admin'] ||
        request.auth.token.email in ['gopal@hirenestworkforce.com', 'gopalkrishna0046@gmail.com']
      );
    }

    match /compliance/{organizationId}/{allPaths=**} {
      allow read: if isOrgMember(organizationId) || isAdmin();
      allow write: if isAdmin() || isOrgMember(organizationId);
      allow delete: if isAdmin();
    }

    match /resumes/{organizationId}/{candidateId}/{fileName} {
      allow read: if isAdmin() || (isOrgMember(organizationId) && request.auth.token.get('role', '') in ['vendor_admin', 'vendor_recruiter', 'client_admin', 'client_hm', 'recruiter', 'admin', 'candidate']);
      allow write: if isAdmin() || (
        isOrgMember(organizationId) && 
        request.auth.token.get('role', '') in ['vendor_admin', 'vendor_recruiter', 'recruiter', 'admin', 'candidate'] &&
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('application/pdf') ||
         request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
         request.resource.contentType.matches('application/msword') ||
         request.resource.contentType.matches('text/plain'))
      );
      allow delete: if isAdmin() || (isOrgMember(organizationId) && request.auth.token.get('role', '') in ['vendor_admin', 'admin']);
    }

    match /resumes/{organizationId}/{allPaths=**} {
      allow read: if isAdmin() || (isOrgMember(organizationId) && request.auth.token.get('role', '') in ['vendor_admin', 'vendor_recruiter', 'client_admin', 'client_hm', 'recruiter', 'admin', 'candidate']);
      allow write: if isAdmin() || (
        isOrgMember(organizationId) && 
        request.auth.token.get('role', '') in ['vendor_admin', 'vendor_recruiter', 'recruiter', 'admin', 'candidate'] &&
        request.resource.size < 15 * 1024 * 1024
      );
      allow delete: if isAdmin() || (isOrgMember(organizationId) && request.auth.token.get('role', '') in ['vendor_admin', 'admin']);
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}


